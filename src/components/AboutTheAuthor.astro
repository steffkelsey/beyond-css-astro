---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsAuthor } from '../lib/tina/data';

interface Props {
  author?: CmsAuthor | null;
}
const { author } = Astro.props;
---

<aside class="flow">
  <h2 class="fs-500 fw-semi-bold">About the author</h2>
  <div class="author">
    <img
      class="border-radius-2"
      src=`${author?.image}`
      alt=""
      data-tina-field={tinaField(author, 'image')}
    />
    <div>
      <h3
        class="fs-600 fw-semi-bold"
        data-tina-field={tinaField(author, 'name')}
      >
        {author?.name}
      </h3>
      <p
        class="clr-neutral-300"
        data-tina-field={tinaField(author, 'description')}
      >
        {author?.description}
      </p>
    </div>
  </div>
</aside>

<style lang="scss">
  .author {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: start;

    > img {
      width: 9.5rem;
      aspect-ratio: 1;
      object-fit: cover;
    }

    > div {
      flex-grow: 1;
      flex-basis: 70%;
    }
  }
</style>
