---
import FormattedDate from './FormattedDate.astro';
import Tag from './Tag.astro';
import { createExcerpt } from '../utils/create-excerpt';
const { article, excerptLength = 0 } = Astro.props;
const withExcerpt = excerptLength > 0;

// TODO prop to layout with text to right of image
---

<article class="flow">
  <div class="image-container">
    <img src={article.imageSrc} alt={article.imageAlt} />
    <Tag class="tag" tag={article.tags[0]} />
  </div>
  <FormattedDate date={article.date} />
  <h3 class="fs-500 fw-bold">{article.title}</h3>
  {
    withExcerpt && (
      <p>{createExcerpt(article.body).substring(0, excerptLength)}...</p>
    )
  }
  <p>
    <a href={`/articles/${article._sys.filename}`}
      >Read more <span class="visually-hidden">about {article.title}</span></a
    >
  </p>
</article>

<style lang="scss">
  @use '../styles/abstracts' as *;

  article {
    --_article-preview-layout: var(--article-preview-layout, default);
    --_article-preview-right-column: var(--article-preview-right-column, 1fr);
    --flow-spacer: #{$article-preview-spacing};
  }

  .image-container {
    position: relative;
    display: inline-block;
  }

  .tag {
    position: absolute;
    bottom: $article-preview-tag-offset;
    left: $article-preview-tag-offset;

    &:hover,
    &:focus-visible {
      text-decoration: none;
    }
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: $article-preview-aspect-ratio;
    border-radius: $border-radius-2;
  }

  @container style(--article-preview-layout: alternative) {
    article {
      --flow-spacer: 0;

      display: grid;
      grid-template-columns: 1fr var(--_article-preview-right-column, 1fr);
      grid-template-rows: auto auto auto 1fr;
      grid-template-areas:
        'image date'
        'image title'
        'image excerpt'
        'image link';
      gap: 0.5rem 1rem;

      .image-container {
        grid-area: image;
      }

      h2 {
        grid-area: title;
      }

      p:not(:has(a)) {
        grid-area: excerpt;
      }

      p:has(a) {
        grid-area: link;
      }
    }
  }
</style>
