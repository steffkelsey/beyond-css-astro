---
const {
  href,
  theme = 'default',
  class: className,
  fullWidth = false,
  position = 'static',
  ...rest
} = Astro.props;
let El = 'button';
if (href) El = 'a';
let width = 'auto';
if (fullWidth) {
  width = '100%';
}
---

<El
  class:list={['button', className]}
  {href}
  data-type={theme}
  style={`--width: ${width}; --position: ${position};`}
  {...rest}
>
  <slot />
</El>

<style lang="scss">
  @use '../styles/abstracts' as *;

  .button {
    position: var(--position);
    width: var(--width);
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: $button-flex-gap;
    cursor: pointer;
    text-decoration: none;
    line-height: 1;
    font-family: $button-font-family;
    font-size: $button-font-size;
    text-transform: $button-text-transform;
    font-weight: $button-font-weight;
    padding: $button-padding;
    border: $button-border;
    border-radius: $button-border-radius;
    transition: 275ms ease;

    &[data-type='primary'] {
      background-color: $button-primary-background;
      color: $button-primary-color;

      &:is(:hover, :focus) {
        background-color: $button-primary-background-hover;
        color: $button-primary-color-hover;
      }
    }

    &[data-type='secondary'] {
      border: $button-secondary-border;
      background-color: $button-secondary-background;
      color: $button-secondary-color;

      &:is(:hover, :focus) {
        background-color: $button-secondary-background-hover;
        color: $button-secondary-color-hover;
      }
    }

    &[data-type='accent'] {
      background-color: $button-accent-background;
      color: $button-accent-color;

      &:is(:hover, :focus) {
        background-color: $button-accent-background-hover;
        color: $button-accent-color-hover;
      }
    }

    &[data-type='instagram'] {
      background-image: $button-instagram-background-image;
      color: $button-instagram-color;

      &:is(:hover, :focus) {
        background-image: $button-instagram-background-image-hover;
        color: $button-instagram-color-hover;
      }
    }

    &[data-type='facebook'] {
      background-color: $button-facebook-background;
      color: $button-facebook-color;

      &:is(:hover, :focus) {
        background-color: $button-facebook-background-hover;
        color: $button-facebook-color-hover;
      }
    }

    &[data-type='twitter'] {
      background-color: $button-twitter-background;
      color: $button-twitter-color;

      &:is(:hover, :focus) {
        background-color: $button-twitter-background-hover;
        color: $button-twitter-color-hover;
      }
    }
  }
</style>
