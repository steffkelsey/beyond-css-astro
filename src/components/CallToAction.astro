---
import Button from './Button.astro';
const { withImage } = Astro.props;
---

<div class="cta flow" data-type={withImage && 'image'}>
  <h2>Want to get the latest insights on Travel Fun Food?</h2>
  <p>We promise, we won't spam you</p>
  <form action="POST" class="subscribe-form">
    <label class="visually-hidden" for="email">Email:</label>
    <input type="email" name="email" placeholder="Email" />
    <Button theme="primary">Subscribe to Newsletter</Button>
  </form>
</div>

<style lang="scss">
  @use '../styles/abstracts/' as *;
  .cta {
    container-type: inline-size;
    background-image: linear-gradient(transparent, $color-accent-100);
    background-repeat: no-repeat;
    background-size: 100% 80vh;
    padding: clamp(1.75rem, 1.0652rem + 3.0435cqi, 3.5rem);
    border-radius: $border-radius-2;
    border: 1px solid $color-neutral-100;

    > h2 {
      font-family: $font-family-accent;
      font-size: clamp(2rem, -1rem + 5.7143cqi, 3rem);
      font-weight: $font-weight-bold;
      color: $color-neutral-1000;
      line-height: 1;
    }

    > p {
      color: $color-neutral-300;
      font-size: $font-size-500;
    }

    .subscribe-form {
      flex-wrap: wrap;
      > input {
        width: 100%;
      }

      > button {
        width: 100%;
      }
    }

    @include mq(medium) {
      .subscribe-form {
        flex-wrap: no-wrap;
        > input {
          width: auto;
        }

        > button {
          width: auto;
        }
      }
    }

    &[data-type='image'] {
      $trans-yellow: rgb(from var(--secondary-100) r g b / 0.09);
      background-image:
        linear-gradient(to right, $color-accent-400 30%, $trans-yellow 100%),
        url('/images/newsletter-cta.jpg');
      background-size: 100%, 70%;
      background-position: right;
      border: 0px;

      > h2 {
        //font-size: clamp(2rem, -1rem + 5.7143cqi, 3rem);
        max-width: 23ch;
      }

      > p {
        color: $color-neutral-1000;
      }
    }
  }

  .subscribe-form {
    display: flex;
    gap: 1rem;
  }
</style>
