---
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<svg aria-hidden="true" width="100%" height="2" viewBox="0 0 100 2" class={`${className}`} preserveAspectRatio="none">
  <line x1="0" y1="1" x2="100" y2="1" stroke="var(--divider-color)" stroke-width="1" stroke-linecap="square" />
</svg>
