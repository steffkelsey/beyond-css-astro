---
interface Props {
  class?: string;
  thickness?: number;
}
const { thickness = 1, class: className = '' } = Astro.props;
const height = thickness + 1;
const y = Math.ceil(height / 2);
---

<svg
  aria-hidden="true"
  width="100%"
  height={height}
  viewBox=`0 0 100 ${height}`
  class={`${className}`}
  preserveAspectRatio="none"
>
  <line
    x1="0"
    y1={y}
    x2="100"
    y2={y}
    stroke="var(--divider-color)"
    stroke-width={thickness}
    stroke-linecap="square"></line>
</svg>
