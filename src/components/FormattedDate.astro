---
const {date} = Astro.props
---
<time datetime={date.toISOString()}>
  {date.toLocaleDateString('default', {day: 'numeric'})} {date.toLocaleDateString('default', {month: 'short'})}, {date.getFullYear()}
</time>

<style lang="scss">
  @use '../styles/abstracts' as *;
  time {
    color: $date-color;
  }
</style>
