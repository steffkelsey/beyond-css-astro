---
const { src, alt = '', maxHeight = '40vmin' } = Astro.props;
---

<img src={src} alt={alt} style={`--max-height: ${maxHeight}`} />

<style lang="scss">
  @use '../styles/abstracts/' as *;
  img {
    max-height: var(--max-height);
    object-fit: cover;
    width: 100dvw;
    max-width: 100dvw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }
</style>
