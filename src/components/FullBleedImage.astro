---
const { src, alt = '', maxHeight = '40vmin', marginTop = '3rem' } = Astro.props;
---

<img src={src} alt={alt} style={`--max-height: ${maxHeight}; --margin-top: ${marginTop};` } />

<style lang="scss">
  @use '../styles/abstracts/' as *;
  img {
    max-height: var(--max-height);
    object-fit: cover;
    width: 100dvw;
    max-width: 100dvw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-inline-start: -50vw;
    margin-inline-end: -50vw;
    margin-block-start: var(--margin-top);
  }
</style>
