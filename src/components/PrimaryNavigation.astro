---
const { hideHome, label, id, class: className, ...rest } = Astro.props
---

<nav {id} aria-label={label} class:list={[className]} {...rest}>
  <ul class="nav" {...rest}>
    {!hideHome && <li><a href="/">Home</a></li>}
    <li><a href="/articles">Articles</a></li>
    <li><a href="/about">About</a></li>
    <li><a href="/contact">Contact</a></li>
  </ul>
</nav>

<style lang="scss">
  @use "../styles/abstracts" as *;
  .nav {
    --flex-column-gap: #{$navigation-gap};

    list-style: none;
    font-family: $navigation-font-family;
    font-weight: $navigation-font-weight;

    a {
      color: $navigation-color;
      text-decoration: $navigation-link-text-decoration;

      &:is(:hover, :focus) {
        color: $navigation-color-hover;
      }
    }
  }
</style>
