---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsConfigSocialLink } from '../lib/tina/data';

interface Props {
  links?: CmsConfigSocialLink[] | null;
  class?: String | null;
}

const { links, class: className, ...rest } = Astro.props;
---

<ul class:list={['flex-group', className]} {...rest}>
  {
    links?.map((item) => (
      <li>
        <a aria-label={item.title} href={item.link} target="_blank">
          <img
            src={item.icon}
            alt=""
            data-tina-field={tinaField(item, 'icon')}
          />
        </a>
      </li>
    ))
  }
</ul>

<style lang="scss">
  @use '../styles/abstracts' as *;

  ul {
    --flex-column-gap: #{$navigation-gap};

    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
