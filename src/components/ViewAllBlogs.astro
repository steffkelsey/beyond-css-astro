---
import Button from './Button.astro';
const { class: className = '', withBorder } = Astro.props;
---

<div class:list={[withBorder && 'border-top padding-block-start-8', className]}>
  <p>We have got lot more exciting blogs for you. Feel free to explore them.</p>
  <Button theme="secondary" href="/articles">View all blogs</Button>
</div>

<style lang="scss">
  @use '../styles/abstracts' as *;

  div {
    display: flex;
    gap: $size-8;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;

    > p {
      text-align: center;
      font-size: $sub-heading-1-font-size;
      color: $color-neutral-300;
      font-weight: $font-weight-semi-bold;
    }

    > .button {
      flex-shrink: 0;
    }

    @include mq(medium) {
      justify-content: space-between;
      flex-wrap: nowrap;
      > p {
        text-align: left;
      }
    }
  }

  .border-top {
    border-top: $divider;
  }
</style>
