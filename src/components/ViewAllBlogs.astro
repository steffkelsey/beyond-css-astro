---
import { tinaField } from '@tinacms/astro/tina-field';
import Button from './Button.astro';
import type { TitleActionField } from '../lib/tina/data';

interface Props {
  data?: TitleActionField | null;
  withBorder?: boolean | false;
  class?: string | null;
}

const { class: className = '', data, withBorder } = Astro.props;
const showBorder = withBorder || data?.showTopBorder;
---

<div class:list={[showBorder && 'border-top padding-block-start-8', className]}>
  <p data-tina-field={tinaField(data, 'title')}>
    {
      (data?.title && data?.title) ||
        'We have got lot more exciting blogs for you. Feel free to explore them.'
    }
  </p>
  <Button
    theme="secondary"
    href="/articles"
    data-tina-field={tinaField(data, 'label')}
  >
    {(data?.label && data?.label) || 'View all blogs'}
  </Button>
</div>

<style lang="scss">
  @use '../styles/abstracts' as *;

  div {
    display: flex;
    gap: $size-8;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;

    > p {
      text-align: center;
      font-size: $sub-heading-1-font-size;
      color: $color-neutral-300;
      font-weight: $font-weight-semi-bold;
    }

    > .button {
      flex-shrink: 0;
    }

    @include mq(medium) {
      justify-content: space-between;
      flex-wrap: nowrap;
      > p {
        text-align: left;
      }
    }
  }

  .border-top {
    border-top: $divider;
  }
</style>
