---
import { tinaField } from '@tinacms/astro/tina-field';
import type { PageBlock } from '../../lib/tina/data';
import Cta from './Cta.astro';
import Divider from './Divider.astro';
import Hero from './Hero.astro';

interface Props {
  data?: Array<PageBlock> | null;
}

const { data } = Astro.props;
---

{
  data?.map((block) => {
    const rendered = (() => {
      switch (block.__typename) {
        case 'PageBlocksCta':
          return <Cta data={block} />;
        case 'PageBlocksDivider':
          return <Divider data={block} />;
        case 'PageBlocksHero':
          return <Hero data={block} withAccent={data?.withGradient} />;
      }
    })();
    return (
      <>
        <div data-tina-field={tinaField(block)}>{rendered}</div>
      </>
    );
  })
}
