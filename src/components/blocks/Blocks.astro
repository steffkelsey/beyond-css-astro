---
import { tinaField } from '@tinacms/astro/tina-field';
import type { PageBlock } from '../../lib/tina/data';
import type { Page } from 'astro';
import ArticleGrid from './ArticleGrid.astro';
import ArticlePaginator from './ArticlePaginator.astro';
import ArticleStrip from './ArticleStrip.astro';
import ContactForm from './ContactForm.astro';
import Content from './Content.astro';
import Cta from './Cta.astro';
import Divider from './Divider.astro';
import Hero from './Hero.astro';
import LargeArticlePreview from './LargeArticlePreview.astro';
import SocialActions from './SocialActions.astro';

interface Props {
  data?: Array<PageBlock> | null;
  withGradient: boolean;
  page?: Page | null;
}

const { data, page, withGradient = false } = Astro.props;
---

{
  data?.map((block) => {
    const rendered = (() => {
      switch (block.__typename) {
        case 'PageBlocksArticleGrid':
          return <ArticleGrid data={block} />;
        case 'PageBlocksArticlePaginator':
          return <ArticlePaginator data={block} {page} />;
        case 'PageBlocksArticleStrip':
          return <ArticleStrip data={block} />;
        case 'PageBlocksContactForm':
          return <ContactForm data={block} />;
        case 'PageBlocksContent':
          return <Content data={block} class="flow full-article" />;
        case 'PageBlocksCta':
          return <Cta data={block} />;
        case 'PageBlocksDivider':
          return <Divider data={block} />;
        case 'PageBlocksHero':
          return <Hero data={block} withAccent={withGradient} />;
        case 'PageBlocksLargeArticlePreview':
          return <LargeArticlePreview data={block} />;
        case 'PageBlocksSocialActions':
          return <SocialActions data={block} />;
      }
    })();
    return (
      <>
        <div data-tina-field={tinaField(block)}>{rendered}</div>
      </>
    );
  })
}
