---
import CallToAction from '../CallToAction.astro';
import type { CtaBlock } from '../../lib/tina/data';

interface Props {
  data: CtaBlock;
}
const { data } = Astro.props;
const type = data.width;
const hasType = type !== 'regular';
---

<section
  class:list={['container', data.withPadding && 'section']}
  data-type={hasType && type}
>
  <CallToAction withImage={data.withImage} {data} />
</section>
