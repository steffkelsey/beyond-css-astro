---
import Blocks from '../blocks/Blocks.astro';
import Gradient from '../Gradient.astro';
import type { CmsPage } from '../../lib/tina/data';
import type { Page } from 'astro';

interface Props {
  data?: CmsPage | null;
  page?: Page | null;
}

const { data, page } = Astro.props;
const blocks = (data?.blocks ?? []).filter((b) => b !== null);
---

{data?.withGradient && <Gradient />}
{
  data && (
    <Blocks
      {page}
      data={blocks}
      withGradient={data.withGradient ? data.withGradient : false}
    />
  )
}
