---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import BaseLayout from './BaseLayout.astro';
import { getPage } from '../lib/tina/data';
import PageBody from '../components/islands/PageBody.astro';

interface Props {
  title: string;
  description: string;
  author?: string | null;
  slug: string;
}

const p = await getPage('article');
const data = p.data?.page;
if (!data) return new Response('Not Found', { status: 404 });

const { title, description, author, slug } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  author={author}
  ogimage={`/open-graph/${slug}.png`}
>
  <main id="main">
    <slot />
    <TinaIsland
      name="page"
      wrapper={{ tag: 'div' }}
      params={{ slug: 'article' }}
    >
      <PageBody data={data} />
    </TinaIsland>
  </main>
</BaseLayout>
