---
import AboutTheAuthor from '../../components/AboutTheAuthor.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Tag from '../../components/Tag.astro';
import {
  getArticle,
  listArticles,
  listFeaturedArticles,
} from '../../lib/tina/data';
import OverflowGrid from '../../components/OverflowGrid.astro';
import ViewAllBlogs from '../../components/ViewAllBlogs.astro';
import CallToAction from '../../components/CallToAction.astro';
import FullBleedImage from '../../components/FullBleedImage.astro';
import Divider from '../../components/Divider.astro';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';

export async function getStaticPaths() {
  const articles = await listArticles();

  return articles.map((article) => ({
    params: { slug: article._sys.filename },
  }));
}

const slug = (Astro.params.slug ?? '').toString();
const thisArticle = await getArticle(slug);
const article = thisArticle.data?.article;
if (!article) return new Response('Not Found', { status: 404 });

const featuredArticles = await listFeaturedArticles();
---

<BaseLayout
  title={article.title}
  description={article.subtitle}
  author={article.author?.name}
  ogimage={`/open-graph/${article._sys.filename}.png`}
>
  <article class="full-article | container section flow" data-type="narrow">
    <div class="meta fs-400">
      <div class="flex-group align-center">
        {article.tags.map((tag) => <Tag class="tag" {tag} />)}
        <FormattedDate date={article.date} />
      </div>
      <a
        href="#"
        class="flex-group align-center"
        style="--flex-column-gap: .5rem"
      >
        <img src="/images/share.svg" alt="" />
        <span>Share</span>
      </a>
    </div>
    <h1 class="heading-2">{article.title}</h1>
    <p class="clr-neutral-300 fs-600">{article.subtitle}</p>
    <FullBleedImage src={article.imageSrc} alt={article.imageAlt} />
    <TinaMarkdown content={article.body} />
    <AboutTheAuthor
      name={article.author?.name}
      description={article.author?.description}
      image={article.author?.image}
    />
  </article>

  <section class="section container">
    <Divider />
  </section>

  <section class="featured section flow container">
    <h2 class="heading-2">Featured travel articles</h2>
    <div class="grid-auto-fit">
      <OverflowGrid articles={featuredArticles.slice(0, 3)} columnSize="60%" />
    </div>
    <ViewAllBlogs withBorder class="padding-block-8" />
  </section>

  <section class="section container">
    <CallToAction withImage />
  </section>
</BaseLayout>

<style lang="scss">
  @use '../../styles/abstracts' as *;

  .meta {
    width: 100%;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .featured {
    --flow-spacer: #{$featured-content-block-padding};
  }
</style>
