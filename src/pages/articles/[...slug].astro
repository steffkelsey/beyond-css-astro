---
import ArticlePost from '../../layouts/ArticlePost.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import ArticleBody from '../../components/islands/ArticleBody.astro';
import { getArticle, listArticles } from '../../lib/tina/data';
import { islands } from '../../lib/tina/islands';

export async function getStaticPaths() {
  const articles = await listArticles();

  return articles.map((node) => ({
    params: { slug: node._sys.filename },
  }));
}

const slug = (Astro.params.slug ?? '').toString();
const a1 = await getArticle(slug);
const article = a1.data?.article;
if (!article) return new Response('Not Found', { status: 404 });

const layoutProps = {
  title: article.title ?? '',
  description: article.subtitle ?? '',
  author: article.author?.name ?? '',
  slug: slug,
};
---

<ArticlePost {...layoutProps}>
  <TinaIsland
    name="article"
    wrapper={islands.article.wrapper}
    params={{ slug }}
    primary
  >
    <ArticleBody data={article} />
  </TinaIsland>
</ArticlePost>
